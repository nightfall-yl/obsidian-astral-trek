{
  "name": "astral-trek",
  "version": "26.1.5",
  "description": "An interactive home dashboard for tasks, knowledge graph, plugins, vault health, and writing activity.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "presync": "node version-bump.mjs",
    "build": "npm run presync && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "dashboard",
    "statistics",
    "heatmap",
    "backlinks"
  ],
  "author": "nightfall",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightfall-yl/obsidian-astral-trek.git"
  },
  "homepage": "https://github.com/nightfall-yl/obsidian-astral-trek#readme",
  "bugs": {
    "url": "https://github.com/nightfall-yl/obsidian-astral-trek/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.17",
    "@types/unist": "^3.0.3",
    "esbuild": "0.25.5",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.8.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.6.0",
    "obsidian": "latest",
    "obsidian-dataview": "^0.5.64",
    "svelte-preprocess": "^4.10.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "async-lock": "^1.4.1",
    "diff-match-patch": "^1.0.5",
    "loglevel": "^1.9.2",
    "luxon": "^3.4.4",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-util-combine-extensions": "^2.0.1",
    "moment-parseformat": "^4.0.0",
    "obsidian-calendar-ui": "^0.3.12",
    "obsidian-daily-notes-interface": "^0.9.5",
    "quick-lru": "^7.3.0",
    "svelte": "^3.59.2",
    "ts-dedent": "^2.3.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  }
}
